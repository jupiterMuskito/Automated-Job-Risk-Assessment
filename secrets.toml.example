# Copy what you need into Streamlit Community Cloud: App > Settings > Secrets.
# Never commit a real secrets.toml to GitHub.

# Optional: register file name or path (default: OKPELLA_Master_Workbook_v8.xlsx next to app.py)
# WORKBOOK_PATH = "OKPELLA_Master_Workbook_v8.xlsx"

# ---- Option A: username + password (pilot) --------------------------------------
# Without a [users] section the app uses the TEST account: okpella.test / Okpella@Test2026
# Create each line with:  python make_password_hash.py
[users.jakukuata]
name = "John Akukuata"
password_hash = "pbkdf2_sha256$200000$REPLACE$REPLACE"

# ---- Option B: Microsoft (Entra ID) sign-in (later, needs IT) ----------------------
# Adding this block switches the app to Microsoft sign-in; [users] is then ignored.
# ALLOWED_EMAIL_DOMAIN = "dangote.com"
# [auth]
# redirect_uri = "https://YOUR-APP-NAME.streamlit.app/oauth2callback"
# cookie_secret = "REPLACE-WITH-A-LONG-RANDOM-STRING"
# client_id = "REPLACE-WITH-APPLICATION-CLIENT-ID"
# client_secret = "REPLACE-WITH-CLIENT-SECRET-VALUE"
# server_metadata_url = "https://login.microsoftonline.com/REPLACE-WITH-TENANT-ID/v2.0/.well-known/openid-configuration"

# Local testing only: switch sign-in off
# LOGIN_MODE = "none"
